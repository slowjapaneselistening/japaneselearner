1185
01:20:29,798 --> 01:20:34,065
بسته به کشور و بانک متفاوت است.

1186
01:20:34,065 --> 01:20:39,898
بسته به N = بسته به N
فرق دارد ↔ یکسان است

1187
01:20:39,921 --> 01:20:42,829
آزمون شنیداری

1188
01:20:42,829 --> 01:20:46,196
هزینه کارمزد چقدر است؟

1189
01:20:46,196 --> 01:20:50,863
قیمت N چقدر است؟ = N چقدر است؟
کارمزد = هزینه

1190
01:20:50,886 --> 01:20:55,680
آزمون شنیداری

1191
01:20:55,680 --> 01:21:01,396
هزینه حواله از باجه ۴۰۰۰ ین است.

1192
01:21:01,396 --> 01:21:09,191
طول می‌کشد / هزینه دارد = طول می‌کشد یا هزینه بر است
باجه خدمات = باجه

1193
01:21:09,215 --> 01:21:11,881
آزمون شنیداری

1194
01:21:11,881 --> 01:21:14,916
۴۰۰۰ ین؟

1195
01:21:19,206 --> 01:21:22,173
آزمون شنیداری

1196
01:21:22,173 --> 01:21:25,608
کمی گران است.

1197
01:21:25,608 --> 01:21:30,341
کمی + صفت い = کمی صفت い
گران ↔ ارزان

1198
01:21:30,364 --> 01:21:33,114
آزمون شنیداری

1199
01:21:33,114 --> 01:21:36,285
عذر می‌خواهم.

1200
01:21:36,285 --> 01:21:40,662
عذر می‌خواهم = متأسفم

1201
01:21:40,686 --> 01:21:44,038
آزمون شنیداری

1202
01:21:44,038 --> 01:21:47,956
آیا می‌توانم از طریق اپلیکیشن پول بفرستم؟

1203
01:21:47,956 --> 01:21:53,389
آیا می‌توانید + فعل؟ = می‌توانید ... کنید؟

1204
01:21:53,412 --> 01:21:55,245
بله.

1205
01:21:55,268 --> 01:21:58,735
آزمون شنیداری

1206
01:21:58,735 --> 01:22:02,802
می‌توانید از طریق بانکداری اینترنتی هم ارسال کنید.

1207
01:22:02,802 --> 01:22:08,355
حتی با N = حتی با N / همچنین با N

1208
01:22:08,379 --> 01:22:11,319
آزمون شنیداری

1209
01:22:11,319 --> 01:22:14,752
آن روش ارزان‌تر است؟

1210
01:22:14,752 --> 01:22:19,485
آن روش بهتر است ... = آن راه ارزان‌تر است
ارزان ↔ گران

1211
01:22:19,508 --> 01:22:21,652
بله.

1212
01:22:21,675 --> 01:22:25,709
آزمون شنیداری

1213
01:22:25,709 --> 01:22:30,475
برای اینترنتی بودن، کارمزد ۳۰۰۰ yen است.

1214
01:22:30,475 --> 01:22:36,988
اگر N باشد = اگر N باشد

1215
01:22:37,012 --> 01:22:40,478
آزمون شنیداری

1216
01:22:40,478 --> 01:22:44,545
خب، می‌خواهم از طریق اینترنت انجام دهم.

1217
01:22:44,545 --> 01:22:50,119
می‌خواهم + V = می‌خواهم V

1218
01:22:50,142 --> 01:22:52,409
آزمون شنیداری

1219
01:22:52,409 --> 01:22:54,966
بسیار خوب.

1220
01:22:58,555 --> 01:23:02,189
آزمون شنیداری

1221
01:23:02,189 --> 01:23:06,455
پس آیا می‌خواهید در اپلیکیشن ثبت‌نام کنید؟

1222
01:23:06,455 --> 01:23:12,322
آیا N را انجام می‌دهید؟ = آیا می‌خواهید ثبت‌نام کنید؟
ثبت‌نام = ثبت‌نام

1223
01:23:12,345 --> 01:23:14,217
بله.

1224
01:23:14,240 --> 01:23:16,234
آزمون شنیداری

1225
01:23:16,234 --> 01:23:18,468
بله، لطفاً.

1226
01:23:21,624 --> 01:23:24,758
آزمون شنیداری

1227
01:23:24,758 --> 01:23:28,425
آیا گوشی هوشمند دارید؟

1228
01:23:28,425 --> 01:23:33,458
دارید؟ = همراهتان است؟

1229
01:23:33,481 --> 01:23:35,514
بله.

1230
01:23:35,537 --> 01:23:37,513
آزمون شنیداری

1231
01:23:37,513 --> 01:23:39,710
این یکی.

1232
01:23:42,833 --> 01:23:46,339
آزمون شنیداری

1233
01:23:46,339 --> 01:23:50,446
لطفاً اپلیکیشن بانک ما را دانلود کنید.

1234
01:23:50,446 --> 01:23:56,113
لطفاً + فعل کنید = لطفاً ... کنید
بانک ما = بانک ما

1235
01:23:56,136 --> 01:23:58,410
آزمون شنیداری

1236
01:23:58,410 --> 01:24:01,001
متوجه شدم.

1237
01:24:04,657 --> 01:24:06,891
آزمون شنیداری

1238
01:24:06,891 --> 01:24:09,405
الان انجام می‌دهم.

1239
01:24:12,940 --> 01:24:16,258
آزمون شنیداری

1240
01:24:16,258 --> 01:24:20,158
اگر سؤالی داشتید بپرسید.

1241
01:24:20,158 --> 01:24:25,505
اگر / وقتی فعل کرد = اگر ... کردید / وقتی ... کردید
پرسیدن = پرسیدن

1242
01:24:25,528 --> 01:24:27,562
بله.

1243
01:24:27,585 --> 01:24:30,023
آزمون شنیداری

1244
01:24:30,023 --> 01:24:32,808
ممنونم.

1245
01:24:36,731 --> 01:24:38,231
صحنه ۱۰: نحوه تبدیل ارز خارجی / چگونه ارز خارجی را تبدیل کنیم

1246
01:24:38,231 --> 01:24:41,011
آزمون شنیداری

1247
01:24:41,011 --> 01:24:44,207
خوش آمدید.

1248
01:24:48,697 --> 01:24:50,885
آزمون شنیداری

1249
01:24:50,885 --> 01:24:53,385
ببخشید.

1250
01:24:56,878 --> 01:25:00,345
آزمون شنیداری

1251
01:25:00,345 --> 01:25:04,411
می‌خواهم ارز خارجی تبدیل کنم.

1252
01:25:04,411 --> 01:25:09,971
می‌خواهم فعل کنم = می‌خواهم ... کنم
تبدیل ارز خارجی = تبدیل ارز خارجی

1253
01:25:09,994 --> 01:25:12,527
آزمون شنیداری

1254
01:25:12,527 --> 01:25:15,427
بسیار خوب.

1255
01:25:19,517 --> 01:25:24,350
آزمون شنیداری

1256
01:25:24,350 --> 01:25:30,083
می‌خواهم دلار آمریکا را به ین ژاپن تبدیل کنم.

1257
01:25:30,083 --> 01:25:37,871
N1 را به N2 تبدیل کردن = N1 را به N2 تبدیل کردن
تبدیل کردن = تبدیل کردن / عوض کردن

1258
01:25:37,895 --> 01:25:39,629
بله.

1259
01:25:39,652 --> 01:25:43,430
آزمون شنیداری

1260
01:25:43,430 --> 01:25:47,901
نرخ امروز اینجاست.

1261
01:25:47,901 --> 01:25:54,017
N خواهد شد = نرخ تبدیل خواهد بود
نرخ تبدیل = نرخ تبدیل

1262
01:25:54,041 --> 01:25:57,474
آزمون شنیداری

1263
01:25:57,474 --> 01:26:01,507
هر دلار چند ین است؟

1264
01:26:01,507 --> 01:26:07,044
چقدر است؟ = چقدر می‌شود؟

1265
01:26:07,068 --> 01:26:11,546
آزمون شنیداری

1266
01:26:11,546 --> 01:26:16,879
امروز هر دلار ۱۵۰ ین است.

1267
01:26:16,879 --> 01:26:24,147
N1 برابر است با N2 = N1 همان N2 است

1268
01:26:24,171 --> 01:26:26,671
آزمون شنیداری

1269
01:26:26,671 --> 01:26:29,537
متوجه شدم.

1270
01:26:33,530 --> 01:26:36,640
آزمون شنیداری

1271
01:26:36,640 --> 01:26:40,274
لطفاً ۵۰۰ دلار را تبدیل کنید.

1272
01:26:40,274 --> 01:26:45,267
لطفاً فعل کنید = لطفاً ... کنید

1273
01:26:45,290 --> 01:26:48,057
آزمون شنیداری

1274
01:26:48,057 --> 01:26:51,246
بسیار خوب.

1275
01:26:55,702 --> 01:26:59,602
آزمون شنیداری

1276
01:26:59,602 --> 01:27:04,236
در مجموع چقدر می‌شود؟

1277
01:27:04,236 --> 01:27:10,541
در مجموع = جمعاً

1278
01:27:10,564 --> 01:27:15,064
آزمون شنیداری

1279
01:27:15,064 --> 01:27:20,397
۷۵۰۰۰ ین می‌شود.

1280
01:27:20,397 --> 01:27:27,674
N خواهد شد = مبلغ N خواهد بود

1281
01:27:27,698 --> 01:27:31,365
آزمون شنیداری

1282
01:27:31,365 --> 01:27:35,665
آیا کارمزد هم دارد؟

1283
01:27:35,665 --> 01:27:41,565
هزینه دارد / طول می‌کشد = هزینه دارد یا زمان می‌برد
کارمزد = هزینه خدمات

1284
01:27:41,588 --> 01:27:45,900
آزمون شنیداری

1285
01:27:45,900 --> 01:27:51,015
کارمزد در نرخ محاسبه شده است.

1286
01:27:51,015 --> 01:27:58,049
N2 در N1 گنجانده شده است = N2 در N1 شامل است
شامل بودن = شامل بودن

1287
01:27:58,072 --> 01:28:00,638
آزمون شنیداری

1288
01:28:00,638 --> 01:28:03,572
متوجه شدم.

1289
01:28:07,661 --> 01:28:12,761
آزمون شنیداری

1290
01:28:12,761 --> 01:28:18,861
لطفاً نام خود را در این فرم بنویسید.

1291
01:28:18,861 --> 01:28:27,129
لطفاً در N فعل کنید = لطفاً در فرم ... کنید
فرم = فرم / برگه

1292
01:28:27,153 --> 01:28:30,453
آزمون شنیداری

1293
01:28:30,453 --> 01:28:34,319
با حروف لاتین خوب است؟

1294
01:28:34,319 --> 01:28:39,598
آیا N خوب است؟ = با حروف لاتین خوب است؟
حروف لاتین = حروف لاتین

1295
01:28:39,621 --> 01:28:42,655
آزمون شنیداری

1296
01:28:42,655 --> 01:28:46,188
بله، اشکالی ندارد.

1297
01:28:46,188 --> 01:28:51,055
کافی است = اشکالی ندارد / خوب است

1298
01:28:51,078 --> 01:28:53,578
آزمون شنیداری

1299
01:28:53,578 --> 01:28:56,444
نوشتم.

1300
01:28:56,444 --> 01:29:00,378
فعل کردم = انجام دادم

1301
01:29:00,401 --> 01:29:03,781
آزمون شنیداری

1302
01:29:03,781 --> 01:29:07,747
پاسپورت هم لازم است؟

1303
01:29:07,747 --> 01:29:13,214
N لازم است = به N نیاز است
لازم ↔ غیرضروری

1304
01:29:13,237 --> 01:29:15,475
بله.

1305
01:29:15,499 --> 01:29:19,565
آزمون شنیداری

1306
01:29:19,565 --> 01:29:24,399
برای تأیید هویت شما لازم است.

1307
01:29:24,399 --> 01:29:30,981
برای N = برای N / به منظور N
تأیید هویت = تأیید هویت

1308
01:29:31,004 --> 01:29:34,537
آزمون شنیداری

1309
01:29:34,537 --> 01:29:38,692
بله، بفرمایید.

1310
01:29:44,393 --> 01:29:46,467
آزمون شنیداری

1311
01:29:46,467 --> 01:29:48,784
ممنونم.

1312
01:29:52,073 --> 01:29:55,407
آزمون شنیداری

1313
01:29:55,407 --> 01:29:59,307
بررسی می‌کنم.

1314
01:29:59,307 --> 01:30:04,674
N انجام می‌دهم (فروتنانه) = N را انجام می‌دهم
تأیید = تأیید

1315
01:30:04,698 --> 01:30:08,264
آزمون شنیداری

1316
01:30:08,264 --> 01:30:12,445
پول را چطور تحویل دهم؟

1317
01:30:12,445 --> 01:30:18,183
چگونه فعل کنیم = چطور ... کنیم
تحویل دادن = تحویل دادن

1318
01:30:18,206 --> 01:30:25,306
آزمون شنیداری

1319
01:30:25,306 --> 01:30:33,894
آیا هفت برگ ۱۰۰۰۰ ینی و یک برگ ۵۰۰۰ ینی خوب است؟

1320
01:30:33,894 --> 01:30:45,528
آیا N خوب است؟ = با اسکناس خوب است؟
اسکناس ↔ سکه

1321
01:30:45,551 --> 01:30:50,085
آزمون شنیداری

1322
01:30:50,085 --> 01:30:55,473
لطفاً کمی هم اسکناس‌های ۱۰۰۰ ینی اضافه کنید.

1323
01:30:55,473 --> 01:31:02,821
کمی فعل کنید = کمی ... کنید
مخلوط کردن = مخلوط کردن

1324
01:31:02,844 --> 01:31:05,582
آزمون شنیداری

1325
01:31:05,582 --> 01:31:08,750
بسیار خوب.

1326
01:31:13,150 --> 01:31:22,490
آزمون شنیداری

1327
01:31:22,490 --> 01:31:33,923
لطفاً شش برگ ۱۰۰۰۰ ینی، یک برگ ۵۰۰۰ ینی و ده برگ ۱۰۰۰ ینی بدهید.

1328
01:31:33,923 --> 01:31:49,299
لطفاً N کنید = لطفاً آن را N کنید

1329
01:31:49,323 --> 01:31:52,856
آزمون شنیداری

1330
01:31:52,856 --> 01:31:56,975
متوجه شدم.

1331
01:31:56,975 --> 01:32:02,642
موافقت = موافقت / رضایت

1332
01:32:02,665 --> 01:32:05,198
آزمون شنیداری

1333
01:32:05,198 --> 01:32:08,065
ممنونم.

1334
01:32:12,087 --> 01:32:14,953
آزمون شنیداری

1335
01:32:14,953 --> 01:32:18,253
ببخشید که منتظرتون گذاشتم.

1336
01:32:18,253 --> 01:32:22,809
ببخشید که منتظرتان گذاشتم = معذرت می‌خواهم که شما را منتظر نگه داشتم

1337
01:32:22,832 --> 01:32:26,132
آزمون شنیداری

1338
01:32:26,132 --> 01:32:29,999
این پول شماست.

1339
01:32:29,999 --> 01:32:35,299
اینجا = اینجا (مؤدبانه)

1340
01:32:35,322 --> 01:32:37,822
آزمون شنیداری

1341
01:32:37,822 --> 01:32:40,689
چک می‌کنم.

1342
01:32:40,689 --> 01:32:44,647
N را انجام می‌دهم = N را انجام می‌دهم

1343
01:32:44,671 --> 01:32:47,904
آزمون شنیداری

1344
01:32:47,904 --> 01:32:51,678
بله، مشکلی نیست.

1345
01:32:56,893 --> 01:32:59,409
آزمون شنیداری

1346
01:32:59,409 --> 01:33:02,276
ممنونم.