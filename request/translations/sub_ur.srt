1409
01:27:17,773 --> 01:27:23,806
N کیسے کیا جاتا ہے؟ = N کیسے کیا جاتا ہے؟
دو طرفہ (دو طرفہ) ↔ ایک طرفہ (ایک طرفہ)

1410
01:27:23,829 --> 01:27:28,167
سننے کا امتحان

1411
01:27:28,167 --> 01:27:33,312
دو طرفہ کاپی کے لیے اس بٹن کو دبائیں۔

1412
01:27:33,312 --> 01:27:40,346
N کے لیے، اس N کو V کریں = N کے لیے، اس N کو دبائیں

1413
01:27:40,369 --> 01:27:42,669
سننے کا امتحان

1414
01:27:42,669 --> 01:27:45,261
یہ بٹن ہے نا؟

1415
01:27:48,917 --> 01:27:51,384
سننے کا امتحان

1416
01:27:51,384 --> 01:27:54,169
یہ تو بہت آسان ہے۔

1417
01:27:54,169 --> 01:27:58,069
نا + ہے نا؟ = یہ [صفت] ہے، ہے نا؟
آسان (آسان) ↔ مشکل (مشکل)

1418
01:27:58,092 --> 01:28:02,892
سننے کا امتحان

1419
01:28:02,892 --> 01:28:08,625
جی ہاں، عادت ہو جائے تو بہت آسان ہے۔

1420
01:28:08,625 --> 01:28:16,458
اگر V کریں تو بہت نا + ہو جائے گا = اگر [حالت] ہو تو یہ بہت [صفت] ہو جائے گا
عادی ہونا = عادی ہونا

1421
01:28:16,481 --> 01:28:20,277
سننے کا امتحان

1422
01:28:20,277 --> 01:28:24,750
آپ کے مصروف وقت میں شکریہ۔

1423
01:28:24,750 --> 01:28:30,867
اچھا + جگہ = حالانکہ آپ [صفت] ہیں
مصروف (مصروف) ↔ فارغ (فارغ)

1424
01:28:30,891 --> 01:28:34,524
سننے کا امتحان

1425
01:28:34,524 --> 01:28:38,791
جی نہیں، جب بھی چاہیں پوچھ سکتے ہیں۔

1426
01:28:38,791 --> 01:28:44,657
کبھی بھی V کر کے دیجیے = براہ کرم... کبھی بھی کریں
کبھی بھی = کبھی بھی

1427
01:28:44,680 --> 01:28:47,980
سننے کا امتحان

1428
01:28:47,980 --> 01:28:51,847
جی، آپ نے بہت مدد کی۔

1429
01:28:51,847 --> 01:28:57,147
مدد مل گئی = مدد ملی، بچ گیا

1430
01:28:57,170 --> 01:29:02,248
سننے کا امتحان

1431
01:29:02,248 --> 01:29:08,348
کاپی مکمل ہونے کے بعد دستاویز لینا مت بھولیں۔

1432
01:29:08,348 --> 01:29:16,622
جب V کریں، N کو V نہ کریں = جب [عمل] کریں، براہ کرم N نہ کریں
ختم ہونا (ختم ہونا) ↔ شروع ہونا (شروع ہونا)
بھولنا = بھولنا

1433
01:29:16,646 --> 01:29:19,828
سننے کا امتحان

1434
01:29:19,828 --> 01:29:23,544
جی، احتیاط کروں گا۔

1435
01:29:23,544 --> 01:29:28,677
میں احتیاط کروں گا = میں احتیاط کروں گا
احتیاط کرنا = احتیاط کرنا

1436
01:29:28,700 --> 01:29:32,800
سننے کا امتحان

1437
01:29:32,800 --> 01:29:37,667
اگر کاغذ ختم ہو جائے تو مجھے بتا دیجیے۔

1438
01:29:37,667 --> 01:29:44,300
جب N ختم ہو جائے تو N کو بتائیں = جب N ختم ہو جائے تو N کو بتائیں
کاغذ = کاغذ
ختم ہونا = ختم ہونا

1439
01:29:44,323 --> 01:29:46,919
سننے کا امتحان

1440
01:29:46,919 --> 01:29:49,902
سمجھ گیا۔

1441
01:29:54,067 --> 01:29:57,834
سننے کا امتحان

1442
01:29:57,834 --> 01:30:02,267
بعد میں کاغذ بھرنے کا طریقہ بھی بتا دیجیے گا۔

1443
01:30:02,267 --> 01:30:08,338
N کا V کرنے کا طریقہ بھی بعد میں بتا دیجیے = براہ کرم مجھے بعد میں N کرنے کا طریقہ بھی بتائیں
اضافہ کرنا = بھرنا، دوبارہ بھرنا
بعد (بعد) ↔ پہلے (پہلے)

1444
01:30:08,361 --> 01:30:11,559
سننے کا امتحان

1445
01:30:11,559 --> 01:30:15,293
ہاں، ٹھیک ہے۔

1446
01:30:20,463 --> 01:30:21,963
منظر ۸: ٹیکسی کا مکالمہ / ٹیکسی میں بنیادی بات چیت

1447
01:30:21,963 --> 01:30:24,305
سننے کا امتحان

1448
01:30:24,305 --> 01:30:26,972
معاف کیجئے گا۔

1449
01:30:30,728 --> 01:30:34,032
سننے کا امتحان

1450
01:30:34,032 --> 01:30:37,904
مجھے ساکورا اسٹیشن تک لے چلیے۔

1451
01:30:37,904 --> 01:30:43,223
مجھے N تک لے چلیں = براہ کرم مجھے N تک لے چلیں
چیری کے پھول = چیری کے پھول
اسٹیشن = اسٹیشن

1452
01:30:43,247 --> 01:30:46,713
سننے کا امتحان

1453
01:30:46,713 --> 01:30:50,780
جی ہاں، ساکورا اسٹیشن ٹھیک ہے۔

1454
01:30:50,780 --> 01:30:56,337
یہ N ہے نا؟ = یہ N ہے، ہے نا؟

1455
01:30:56,361 --> 01:30:59,194
سننے کا امتحان

1456
01:30:59,194 --> 01:31:02,461
ٹھیک ہے۔

1457
01:31:02,461 --> 01:31:06,961
سمجھ گیا = ضرور / سمجھ گیا

1458
01:31:06,984 --> 01:31:10,890
سننے کا امتحان

1459
01:31:10,890 --> 01:31:15,523
تقریباً کتنا وقت لگے گا؟

1460
01:31:15,523 --> 01:31:21,828
کتنے منٹ + لگ بھگ = تقریباً کتنے منٹ
تقریباً = تقریباً، لگ بھگ

1461
01:31:21,852 --> 01:31:24,186
سننے کا امتحان

1462
01:31:24,186 --> 01:31:26,852
ہاں واقعی۔

1463
01:31:30,576 --> 01:31:34,110
سننے کا امتحان

1464
01:31:34,110 --> 01:31:38,258
تقریباً پندرہ منٹ لگیں گے۔

1465
01:31:38,258 --> 01:31:43,958
مقدار + لگ بھگ لگے گا = تقریباً (وقت/پیسہ) لگے گا

1466
01:31:43,981 --> 01:31:46,415
سننے کا امتحان

1467
01:31:46,415 --> 01:31:49,192
سمجھ گیا۔

1468
01:31:53,081 --> 01:31:55,715
سننے کا امتحان

1469
01:31:55,715 --> 01:31:58,748
برائے مہربانی۔

1470
01:31:58,748 --> 01:32:02,915
براہ کرم خیال رکھیں = براہ کرم اس کا خیال رکھیں / پہلے سے شکریہ

1471
01:32:02,938 --> 01:32:05,838
سننے کا امتحان

1472
01:32:05,838 --> 01:32:09,194
کیا آپ جلدی میں ہیں؟

1473
01:32:09,194 --> 01:32:13,827
کیا آپ V کر رہے ہیں؟ = کیا آپ جلدی کر رہے ہیں؟
جلدی کرنا = جلدی کرنا

1474
01:32:13,850 --> 01:32:16,083
جی ہاں۔

1475
01:32:16,106 --> 01:32:19,612
سننے کا امتحان

1476
01:32:19,612 --> 01:32:23,717
مجھے دس بجے دوست سے ملنے کا وعدہ ہے۔

1477
01:32:23,717 --> 01:32:29,384
N1 پر N2 ہے = N1 پر N2 ہے
دوست = دوست
وعدہ = وعدہ، منصوبے

1478
01:32:29,407 --> 01:32:33,553
سننے کا امتحان

1479
01:32:33,553 --> 01:32:38,465
ابھی نو بج کر چالیس منٹ ہوئے ہیں۔

1480
01:32:38,465 --> 01:32:45,198
وقت ہو گیا ہے، ٹھیک ہے؟
اب = ابھی

1481
01:32:45,221 --> 01:32:47,854
سننے کا امتحان

1482
01:32:47,854 --> 01:32:50,849
آپ وقت پر پہنچ جائیں گے۔

1483
01:32:50,849 --> 01:32:55,017
وقت پر پہنچ جاؤں گا = وقت پر پہنچنا
وقت پر پہنچنا = وقت پر پہنچنا

1484
01:32:55,041 --> 01:32:57,549
سننے کا امتحان

1485
01:32:57,549 --> 01:33:00,415
بہت اچھا ہوا۔

1486
01:33:04,438 --> 01:33:06,904
سننے کا امتحان

1487
01:33:06,904 --> 01:33:09,738
اب مجھے اطمینان ہوا۔

1488
01:33:09,738 --> 01:33:13,647
مجھے چین آ گیا = چین محسوس کرنا

1489
01:33:13,670 --> 01:33:16,738
سننے کا امتحان

1490
01:33:16,738 --> 01:33:20,304
آج کہیں باہر جا رہے ہیں؟

1491
01:33:20,304 --> 01:33:25,212
باہر جا رہے ہو؟
باہر جانا = باہر نکلنا

1492
01:33:25,236 --> 01:33:27,469
جی ہاں۔

1493
01:33:27,492 --> 01:33:30,959
سننے کا امتحان

1494
01:33:30,959 --> 01:33:35,026
دوست کے ساتھ فلم دیکھنے جا رہا ہوں۔

1495
01:33:35,026 --> 01:33:40,597
V کرنے جاؤں گا = V کرنے کے لیے جانا
فلم = فلم

1496
01:33:40,620 --> 01:33:42,920
سننے کا امتحان

1497
01:33:42,920 --> 01:33:45,515
بہت اچھا ہے۔

1498
01:33:49,173 --> 01:33:52,039
سننے کا امتحان

1499
01:33:52,039 --> 01:33:55,339
کون سی فلم ہے؟

1500
01:33:55,339 --> 01:33:59,881
کس قسم کا N

1501
01:33:59,904 --> 01:34:03,138
سننے کا امتحان

1502
01:34:03,138 --> 01:34:06,884
ایک اینی میٹڈ فلم ہے۔

1503
01:34:06,884 --> 01:34:12,029
N1 کا N2 = N1 کا N2
اینیمی = اینیمی، کارٹون

1504
01:34:12,052 --> 01:34:14,519
سننے کا امتحان

1505
01:34:14,519 --> 01:34:17,352
بہت مزہ آئے گا۔

1506
01:34:17,352 --> 01:34:21,265
نا صفت + ہے = یہ صفت ہے
مزہ = انتظار کرنا، مزہ آنا

1507
01:34:21,289 --> 01:34:23,755
سننے کا امتحان

1508
01:34:23,755 --> 01:34:26,589
اچھا ایسا ہے۔

1509
01:34:30,521 --> 01:34:33,588
سننے کا امتحان

1510
01:34:33,588 --> 01:34:37,136
مزے سے سفر کریں۔

1511
01:34:37,136 --> 01:34:42,043
V کر کے دیں = براہ کرم V کریں
مزہ لینا = لطف اٹھانا

1512
01:34:42,066 --> 01:34:44,533
سننے کا امتحان

1513
01:34:44,533 --> 01:34:47,316
شکریہ۔

1514
01:34:51,206 --> 01:34:56,072
سننے کا امتحان

1515
01:34:56,072 --> 01:35:01,849
اچھا، راستہ تھوڑا مصروف ہے۔

1516
01:35:01,849 --> 01:35:09,729
V رہا ہوں = V کرنے کا حال
سڑک = سڑک
بھرا ہوا = بھیڑ ہونا، ٹریفک جام ہونا

1517
01:35:09,752 --> 01:35:12,219
سننے کا امتحان

1518
01:35:12,219 --> 01:35:15,052
جی واقعی۔

1519
01:35:15,052 --> 01:35:18,956
سچائی = حقیقت، واقعیت

1520
01:35:18,980 --> 01:35:21,682
سننے کا امتحان

1521
01:35:21,682 --> 01:35:24,794
کیا سب ٹھیک ہے؟

1522
01:35:24,794 --> 01:35:29,099
نا صفت + ہو گا؟ = کیا یہ صفت ہو گا؟
ٹھیک ہے = ٹھیک، محفوظ

1523
01:35:29,122 --> 01:35:31,826
سننے کا امتحان

1524
01:35:31,826 --> 01:35:34,931
کوئی بات نہیں۔

1525
01:35:39,288 --> 01:35:42,321
سننے کا امتحان

1526
01:35:42,321 --> 01:35:45,838
آئیے، دوسری سڑک سے چلتے ہیں۔

1527
01:35:45,838 --> 01:35:50,705
V کرتے ہیں = آئیے V کریں
الگ = دوسرا، مختلف
دوڑنا = دوڑنا، گاڑی چلانا

1528
01:35:50,728 --> 01:35:52,828
سننے کا امتحان

1529
01:35:52,828 --> 01:35:55,174
براہ کرم۔

1530
01:35:55,174 --> 01:35:58,474
براہ کرم

1531
01:35:58,497 --> 01:36:01,465
سننے کا امتحان

1532
01:36:01,465 --> 01:36:04,931
معاف کیجیے گا۔

1533
01:36:09,721 --> 01:36:13,354
سننے کا امتحان

1534
01:36:13,354 --> 01:36:17,621
جی ہاں، کیا ہوا؟

1535
01:36:17,621 --> 01:36:23,454
کیا ہوا؟ / میں آپ کی کیا مدد کر سکتا ہوں؟

1536
01:36:23,477 --> 01:36:27,191
سننے کا امتحان

1537
01:36:27,191 --> 01:36:31,566
اسٹیشن کے سامنے کوئی کنوینینس اسٹور ہے؟

1538
01:36:31,566 --> 01:36:37,555
کیا N1 کے N2 پر N3 ہے؟
سامنے (سامنے) ↔ پیچھے (پیچھے)
کونبینی = کنوینینس اسٹور

1539
01:36:37,579 --> 01:36:42,163
سننے کا امتحان

1540
01:36:42,163 --> 01:36:47,629
جی ہاں، ایک بڑا کنوینینس اسٹور ہے۔

1541
01:36:47,629 --> 01:36:55,096
صفت + N = صفت والا N
بڑا (بڑا) ↔ چھوٹا (چھوٹا)

1542
01:36:55,119 --> 01:36:58,186
سننے کا امتحان

1543
01:36:58,186 --> 01:37:01,730
کنوینینس اسٹور کے سامنے گاڑی روک دیجیے۔

1544
01:37:01,730 --> 01:37:06,630
N کے N پر V کر کے دیں = براہ کرم N کے N پر V کریں
روکنا = گاڑی روکنا

1545
01:37:06,653 --> 01:37:11,486
سننے کا امتحان

1546
01:37:11,486 --> 01:37:17,243
اسٹیشن کے داخلے پر نہیں، کنوینینس اسٹور کے سامنے۔

1547
01:37:17,243 --> 01:37:25,077
N1 نہیں بلکہ N2 = N1 نہیں، بلکہ N2
داخلہ (داخلہ) ↔ باہر نکلنے کا راستہ (باہر نکلنے کا راستہ)

1548
01:37:25,101 --> 01:37:29,447
سننے کا امتحان

1549
01:37:29,447 --> 01:37:34,613
جی ہاں، مجھے کچھ پینے کا دل کر رہا ہے۔

1550
01:37:34,613 --> 01:37:41,680
کیونکہ میں V کرنا چاہتا ہوں
پینے کی چیز = مشروب

1551
01:37:41,703 --> 01:37:43,970
سننے کا امتحان

1552
01:37:43,970 --> 01:37:46,518
سمجھ گیا۔

1553
01:37:50,088 --> 01:37:53,192
سننے کا امتحان

1554
01:37:53,192 --> 01:37:56,825
کنوینینس اسٹور کے سامنے گاڑی روک دوں گا۔

1555
01:37:56,825 --> 01:38:01,822
N پر V کرتا ہوں = N پر V کرنا

1556
01:38:01,845 --> 01:38:03,993
سننے کا امتحان

1557
01:38:03,993 --> 01:38:06,427
شکریہ۔

1558
01:38:09,827 --> 01:38:12,161
سننے کا امتحان

1559
01:38:12,161 --> 01:38:14,795
ہم پہنچ گئے ہیں۔

1560
01:38:14,795 --> 01:38:18,467
پہنچنا = پہنچنا

1561
01:38:18,491 --> 01:38:22,403
سننے کا امتحان

1562
01:38:22,403 --> 01:38:27,037
کرایہ پندرہ سو ین ہے۔

1563
01:38:27,037 --> 01:38:33,378
N1، N2 ہے = N1، N2 ہے
فیس = فیس، کرایہ

1564
01:38:33,401 --> 01:38:35,999
سننے کا امتحان

1565
01:38:35,999 --> 01:38:38,987
دو ہزار ین لیں۔

1566
01:38:38,987 --> 01:38:43,121
رقم دے کر براہ کرم = براہ کرم اتنی رقم کے ساتھ

1567
01:38:43,144 --> 01:38:47,410
سننے کا امتحان

1568
01:38:47,410 --> 01:38:52,446
