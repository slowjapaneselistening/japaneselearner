ពិតជាមានអារម្មណ៍រីករាយជាច្រើនណាស់

310
00:22:14,699 --> 00:22:19,965
អ្នកធ្វើដូចម្តេចដែលល្អបំផុត?

311
00:22:19,988 --> 00:22:24,422
ខ្ញុំមិនអាចជ្រើសរើសបាន

312
00:22:24,445 --> 00:22:27,911
ទាំងពីរគឺល្អបំផុត

313
00:22:27,934 --> 00:22:32,468
អារម្មណ៍នៃហុកកៃដូគឺអ្វី?

314
00:22:32,491 --> 00:22:37,924
វាលឡាវេនដែរពណ៌ផ្កាយរបស់ហ័រុនុអូ

315
00:22:37,947 --> 00:22:40,895
ទេសភាពស្រស់បំព្រង

316
00:22:40,918 --> 00:22:47,152
សួនចម្លែកអាស៊ីហ៊ីដឺរីនិងពេញគិនក៏ល្អមើល

317
00:22:47,175 --> 00:22:49,052
ច្រើនទេ

318
00:22:49,076 --> 00:22:54,109
ត្រី និងមីយ៉ុងក៏មានរសជាតិល្អណាស់

319
00:22:54,132 --> 00:22:58,232
អំពីអូគីណាវ៉ាដែលបានទៅលេងនោះ មានអ្វីចងចាំដែរឬទេ?

320
00:22:58,255 --> 00:23:03,733
ត្រីឆ្លាមធំនៅក្នុងសួនចម្លែកទឹកសមុទ្រចុងភាគខាងត្បូង

321
00:23:03,757 --> 00:23:07,098
មានអំណាចខ្លាំងណាស់

322
00:23:07,122 --> 00:23:12,455
កោះគូរ៉ូស៊ីម៉ានៃសមុទ្រខៀវក៏ស្រស់បំព្រង

323
00:23:12,478 --> 00:23:14,797
បាទ/ចាស ត្រជាក់

324
00:23:14,821 --> 00:23:19,763
ទឹកដែលបានផឹកនៅលើឆ្នេរខ្សាច់ពណ៌សមិនអាចភ្លេចបានទេ

325
00:23:19,786 --> 00:23:28,252
ខ្ញុំបានរីករាយជាមួយធម្មជាតិត្រូវនៅភាគខាងជើង និងសមុទ្រក្តៅនៅភាគខាងត្បូង។

326
00:23:28,275 --> 00:23:32,650
នេះជាការធ្វើទុក្ខបុកម្នេញសម្រាប់ការធ្វើដំណើរកម្សាន្តរបស់ក្នុងរដូវក្តៅ។

327
00:23:32,674 --> 00:23:34,741
ច្រើនទេ

328
00:23:34,764 --> 00:23:40,515
ខ្ញុំបានថតរូបជាច្រើន ដូច្នេះយើងត្រូវបង្កើតកំណត់ហេតុផ្ទាល់ខ្លួនមួយដើម្បីរក្សាទុកវា។

329
00:23:40,539 --> 00:23:43,129
ល្អមែន

330
00:23:43,152 --> 00:23:46,820
ខ្ញុំចង់បង្ហាញមិត្តភ័ក្តិរបស់ខ្ញុំផងដែរ។

331
00:23:46,844 --> 00:23:51,744
នៅឆ្នាំក្រោយ យើងត្រូវទៅលេងទីណាម្តងទៀត?

332
00:23:51,766 --> 00:23:56,600
យើងត្រូវរៀបចំកន្លែងថ្មីម្តងទៀត។

333
00:23:56,623 --> 00:23:58,957
បាទ/ចាស ត្រជាក់

334
00:23:58,980 --> 00:24:04,219
ធ្វើការយ៉ាងខ្លាំង ហើយធ្វើដំណើរជាមួយគ្នាម្តងទៀត។