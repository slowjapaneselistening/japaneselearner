536
00:29:31,119 --> 00:29:34,753
هَلْ ذَهَبْتَ لِلْتَّخْيِيمِ مِنْ قَبْلُ؟

537
00:29:34,776 --> 00:29:37,791
لَا، لَكِنْ أُرِيدُ تَجْرِبَتَهُ.

538
00:29:37,814 --> 00:29:40,847
أَنْصَحُكَ بِالْغَلَامْبِنْج.

539
00:29:40,870 --> 00:29:43,278
الْغَلَامْبِنْج؟

540
00:29:43,301 --> 00:29:45,139
مَا هَذَا؟

541
00:29:45,163 --> 00:29:49,196
هُوَ تَخْيِيمٌ مَعَ تَوَفُّرِ جَمِيعِ الْأَدَوَاتِ.

542
00:29:49,219 --> 00:29:52,153
أَلَا نَضْطَرُّ لِإِقَامَةِ الْخَيْمَةِ؟

543
00:29:52,176 --> 00:29:56,209
نَعَمْ، الْخَيْمَةُ الْفَاخِرَةُ مَنْصُوبَةٌ سَلَفًا.

544
00:29:56,232 --> 00:29:59,599
هَلْ يُوجَدُ سَرِيرٌ وَمُكَيِّفُ هَوَاءٍ أَيْضًا؟

545
00:29:59,621 --> 00:30:03,655
نَعَمْ، هُوَ مُرِيحٌ مِثْلَ الْفُنْدُقِ.

546
00:30:03,678 --> 00:30:07,244
إِذًا، سَيَكُونُ الْمُبْتَدِئُونَ بِخَيْرٍ.

547
00:30:07,267 --> 00:30:11,562
تُقَدَّمُ مَوَادُّ الشِّوَاءِ أَيْضًا.

548
00:30:11,586 --> 00:30:14,719
نَشْوِي اللَّحْمَ وَالْخُضْرَوَاتِ وَنَأْكُلُهَا.

549
00:30:14,742 --> 00:30:17,476
يُمْكِنُكَ الذَّهَابُ بِأَيْدٍ فَارِغَةٍ، فَهُوَ مُرِيحٌ.

550
00:30:17,499 --> 00:30:19,832
أَيْنَ يُوجَدُ؟

551
00:30:19,855 --> 00:30:23,622
يُوجَدُ قُرْبَ جَبَلِ فُوجِي وَفِي شِبْهِ جَزِيرَةِ شِبَا.

552
00:30:23,645 --> 00:30:27,078
هَلْ يُمْكِنُ رُؤْيَةُ النُّجُومِ جَمِيلَةً فِي اللَّيْلِ؟

553
00:30:27,101 --> 00:30:31,359
نَعَمْ، لِأَنَّ الْمِنْطَقَةَ مُظْلِمَةٌ، فَتُرَى النُّجُومُ بِوُضُوحٍ.

554
00:30:31,382 --> 00:30:34,382
يُمْكِنُنَا مُرَاقَبَةُ الْأَجْرَامِ السَّمَاوِيَّةِ.

555
00:30:34,405 --> 00:30:38,205
التَّحَدُّثُ حَوْلَ النَّارِ مُمْتِعٌ أَيْضًا.

556
00:30:38,228 --> 00:30:41,202
أُرِيدُ صُنْعَ مَلْوِيَّاتِ الْمَارْشْمَلُو.

557
00:30:41,226 --> 00:30:44,393
إِذَا وَضَعْتَهَا بَيْنَ الْبِسْكُوِيتِ سَيَكُونُ لَذِيذًا.

558
00:30:44,416 --> 00:30:46,695
هَذَا هُوَ السَّمُور.

559
00:30:46,718 --> 00:30:48,685
أُحِبُّهُ كَثِيرًا.

560
00:30:48,708 --> 00:30:52,521
هواء الصباح منعش للغاية.

561
00:30:52,545 --> 00:30:56,022
نتناول الإفطار في أحضان الطبيعة.

562
00:30:56,045 --> 00:30:59,142
نستمتع بوقت فاخر حقاً.

563
00:30:59,165 --> 00:31:02,498
أريد الحجز في العطلة القادمة.

564
00:31:02,521 --> 00:31:04,021
المشهد 18: سحر حمامات السباحة الليلية

565
00:31:04,021 --> 00:31:07,555
هل سمعت عن حمامات السباحة الليلية؟

566
00:31:07,578 --> 00:31:10,746
هل تقصد السباحة ليلاً في المسبح؟

567
00:31:10,770 --> 00:31:15,103
نسبح ليلاً في مسبح الفندق.

568
00:31:15,126 --> 00:31:18,301
إنها مشهورة لأنها لا تسبب اسمرار البشرة.

569
00:31:18,324 --> 00:31:22,411
نعم، إنها مضاءة بشكل جميل.

570
00:31:22,435 --> 00:31:26,238
هل هناك دي جي يشغل الموسيقى؟

571
00:31:26,262 --> 00:31:29,934
تتدفق موسيقى أنيقة.

572
00:31:29,957 --> 00:31:33,390
يمكن التقاط صور رائعة هنا.

573
00:31:33,413 --> 00:31:36,691
العوامات بتصاميم جميلة أيضاً.

574
00:31:36,715 --> 00:31:40,689
هل يمكننا شرب المشروبات؟

575
00:31:40,712 --> 00:31:44,170
يمكنك شرب الكوكتيلات والعصائر.

576
00:31:44,193 --> 00:31:46,660
الجو راقٍ جداً.

577
00:31:46,683 --> 00:31:50,616
تُقام في فنادق فاخرة في طوكيو.

578
00:31:50,639 --> 00:31:53,639
هل هي أبرد من النهار؟

579
00:31:53,662 --> 00:31:57,149
نعم، لأنها بدون شمس.

580
00:31:57,173 --> 00:32:00,306
يمكن الذهاب بعد العمل.

581
00:32:00,329 --> 00:32:03,331
هناك خدمة استئجار ملابس السباحة.

582
00:32:03,354 --> 00:32:06,354
يمكن الذهاب بسهولة.

583
00:32:06,377 --> 00:32:09,744
لنسبح مع الأصدقاء.

584
00:32:09,767 --> 00:32:13,051
هل الحجز ضروري؟

585
00:32:13,075 --> 00:32:17,008
يتم الدفع مسبقاً عبر الإنترنت.

586
00:32:17,031 --> 00:32:19,598
التذاكر هنا مشهورة جداً.

587
00:32:19,621 --> 00:32:23,266
يمكن الاستمتاع بعالم خيالي.

588
00:32:23,289 --> 00:32:26,723
يمكن تذوق أجواء غير عادية.

589
00:32:26,746 --> 00:32:30,079
ستكون ليلة صيفية رائعة.

590
00:32:30,102 --> 00:32:33,001
لنذهب ونجرب.

591
00:32:33,024 --> 00:32:34,524
المشهد 19: قصص الرعب الصيفية وتأثير التبريد

592
00:32:34,524 --> 00:32:39,814
هناك ثقافة الاستماع إلى قصص الرعب في الصيف.

593
00:32:39,838 --> 00:32:44,642
لماذا نروي قصص الرعب في الصيف؟

594
00:32:44,666 --> 00:32:48,633
لأنها تسبب قشعريرة وتبرد الجسم.

595
00:32:48,656 --> 00:32:51,589
سبب ممتع حقاً.

596
00:32:51,612 --> 00:32:55,346
بيوت الأشباح مشهورة أيضاً.

597
00:32:55,368 --> 00:32:58,902
تقصد بيت الأشباح في مدينة الملاهي؟

598
00:32:58,925 --> 00:33:02,858
فوجي-كيو هايلاند مشهور جداً.

599
00:33:02,881 --> 00:33:06,060
بيت الأشباح الذي يشبه المستشفى.

600
00:33:06,084 --> 00:33:10,371
إنه مخيف جداً لدرجة أنك لا تستطيع المشي.

601
00:33:10,394 --> 00:33:15,561
هل هناك ممثلون حقيقيون يؤدون الأدوار؟

602
00:33:15,584 --> 00:33:19,351
نعم، يظهرون فجأة ليخيفوك.

603
00:33:19,374 --> 00:33:22,670
سأصرخ حتماً.

604
00:33:22,693 --> 00:33:25,670
سيقشعر بدنك.

605
00:33:25,693 --> 00:33:28,865
حقاً سيشعرك بالبرودة.

606
00:33:28,889 --> 00:33:32,422
له تأثير تبريد بالفعل.

607
00:33:32,445 --> 00:33:35,778
سندخل معاً مع الأصدقاء.

608
00:33:35,801 --> 00:33:38,578
ستقوى روابط الصداقة.

609
00:33:38,602 --> 00:33:41,935
سنمسك بأيدي بعضنا من الخوف.

610
00:33:41,958 --> 00:33:45,692
القصص التقليدية عن الأشباح ممتعة جدًا.

611
00:33:45,715 --> 00:33:48,681
هل تقصدين قصة يوتسويا للأشباح؟

612
00:33:48,704 --> 00:33:52,537
نعم، يمكنك الاستماع إليها في عروض الراكوغو أيضًا.

613
00:33:52,560 --> 00:33:55,760
أستمع للقصة وأتخيلها.

614
00:33:55,783 --> 00:33:58,917
أشعر بقشعريرة في ظهري.

615
00:33:58,940 --> 00:34:02,219
تجربة لا تُنسى في فصل الصيف.

616
00:34:02,242 --> 00:34:05,694
هل تريدين تجربة ذلك مرة واحدة؟

617
00:34:05,717 --> 00:34:09,990
إنها مخيفة قليلاً، لكني أريد الذهاب.

618
00:34:10,014 --> 00:34:13,308
هيا بنا نذهب بشجاعة.

619
00:34:13,332 --> 00:34:14,832
المشهد 20: تخطيط رحلة الصيف واحتياطات السلامة

620
00:34:14,832 --> 00:34:19,036
لنقم بتلخيص خطة رحلة الصيف.

621
00:34:19,060 --> 00:34:22,342
لدي الكثير من الأشياء التي أريد القيام بها.

622
00:34:22,365 --> 00:34:26,165
لقد أخذنا في الاعتبار أحدث الأخبار أيضًا، أليس كذلك؟

623
00:34:26,188 --> 00:34:29,832
سنهتم جيدًا بإجراءات الوقاية من ضربة الشمس.

624
00:34:29,856 --> 00:34:34,510
سنزور أماكن سياحية داخلية باردة ومنتجعات صيفية.

625
00:34:34,534 --> 00:34:38,510
وسنأكل الكثير من الأطعمة اللذيذة أيضًا.

626
00:34:38,534 --> 00:34:42,310
إدارة الصحة هي الأهم.

627
00:34:42,333 --> 00:34:45,266
سنضع جدولاً زمنيًا مريحًا وبدون إرهاق.

628
00:34:45,289 --> 00:34:49,256
لن ننسى شرب الماء وأخذ فترات راحة.

629
00:34:49,279 --> 00:34:52,857
سنحمل معنا مظلات ومروحة يدوية أيضًا.

630
00:34:52,880 --> 00:34:56,946
يمكننا الاستمتاع بصيف اليابان بأمان.

631
00:34:56,969 --> 00:34:59,940
وسنلتقط الكثير من الصور الجميلة.

632
00:34:59,964 --> 00:35:03,571
سيكون لدينا ذكريات صيفية رائعة.

633
00:35:03,595 --> 00:35:06,961
سنجهز كل شيء جيدًا قبل المغادرة.

634
00:35:06,984 --> 00:35:10,618
حجزنا وسائل النقل مسبقًا.

635
00:35:10,641 --> 00:35:14,041
تأكيد الفندق جاهز تمامًا.

636
00:35:14,063 --> 00:35:17,297
استمتعي برحلتك وأنت مطمئنة.

637
00:35:17,320 --> 00:35:20,586
شكرًا لك على المشاركة في المتعة معي.

638
00:35:20,609 --> 00:35:23,643
أتمنى لك رحلة سعيدة.

639
00:35:23,666 --> 00:35:26,466
نعم، سأذهب الآن.

640
00:35:26,489 --> 00:35:29,577
انتبهي واذهبي بسلام.