00:52:25,980 --> 00:52:30,537
ٹھیک ہے = ٹھیک ہے / کوئی بات نہیں

836
00:52:30,560 --> 00:52:33,678
سننے کا امتحان

837
00:52:33,678 --> 00:52:37,311
بڑا سائز لے لیتے ہیں۔

838
00:52:37,311 --> 00:52:42,304
V-ましょう = آئیے V کریں
بڑا = بڑا ↔ چھوٹا = چھوٹا
سائز = سائز

839
00:52:42,328 --> 00:52:45,630
سننے کا امتحان

840
00:52:45,630 --> 00:52:49,496
امید ہے کہ سب خوش ہوں گے۔

841
00:52:49,496 --> 00:52:54,803
V-て + くれる = کسی کے لئے کچھ کرنا
خوش ہونا = خوش ہونا ↔ غمگین ہونا = غمگین ہونا

842
00:52:54,827 --> 00:52:58,294
سننے کا امتحان

843
00:52:58,294 --> 00:53:02,331
یقیناً خوش ہوں گے۔

844
00:53:02,331 --> 00:53:07,864
یوں = تم جانتے ہو نا / (زور دینے کے لئے)
یقینا = یقینا / بالکل

845
00:53:07,887 --> 00:53:12,195
سننے کا امتحان

846
00:53:12,195 --> 00:53:17,297
ماروتاکے کی تماگویاکی سب سے بہترین ہے۔

847
00:53:17,297 --> 00:53:24,264
N1 کا N2 = N1 کا N2
بہترین = بہترین ↔ بدترین = بدترین

848
00:53:24,288 --> 00:53:27,621
سننے کا امتحان

849
00:53:27,621 --> 00:53:31,493
ہاں، پھر سے کھانا چاہوں گی۔

850
00:53:31,493 --> 00:53:36,826
Vنا چاہتا ہوں = V کرنا چاہتا ہوں
پھر = پھر

851
00:53:36,849 --> 00:53:40,159
سننے کا امتحان

852
00:53:40,159 --> 00:53:44,028
اور بھی دکانیں ہیں۔

853
00:53:44,028 --> 00:53:49,346
میں بھی = میں بھی / پر بھی
دوسرا = دوسرا / اور

854
00:53:49,370 --> 00:53:52,236
سننے کا امتحان

855
00:53:52,236 --> 00:53:55,516
چلو بہت کچھ دیکھتے ہیں۔

856
00:53:55,516 --> 00:54:00,050
V-て + みましょう = آئیے V کرنے کی کوشش کریں
بہت زیادہ = بہت زیادہ ↔ تھوڑا = تھوڑا

857
00:54:00,073 --> 00:54:01,573
منظر 7: آرام اور ڈango / آرام اور ڈango

858
00:54:01,573 --> 00:54:04,839
سننے کا امتحان

859
00:54:04,839 --> 00:54:08,673
ذرا تھک گئے ہیں۔

860
00:54:08,673 --> 00:54:13,907
V-ました = کیا (مؤدب ماضی)
تھوڑا = تھوڑا
تھک جانا = تھک جانا

861
00:54:13,930 --> 00:54:17,363
سننے کا امتحان

862
00:54:17,363 --> 00:54:21,397
کسی جگہ بیٹھ کر آرام کرتے ہیں۔

863
00:54:21,397 --> 00:54:26,930
V-ましょう = آئیے کریں
آرام کرنا = آرام کرنا

864
00:54:26,953 --> 00:54:30,735
سننے کا امتحان

865
00:54:30,735 --> 00:54:35,202
موسکے ڈango ہے نا۔

866
00:54:35,202 --> 00:54:41,336
N موجود ہے = N موجود ہے
موسوکی دانگو = موسوکی دانگو (برانڈ کا نام)

867
00:54:41,359 --> 00:54:44,705
سننے کا امتحان

868
00:54:44,705 --> 00:54:48,618
موسکے ڈango؟

869
00:54:48,618 --> 00:54:54,001
کیا یہ N ہے؟ = کیا یہ N ہے؟
دانگو = میٹھی ڈمپلنگ

870
00:54:54,024 --> 00:54:58,900
سننے کا امتحان

871
00:54:58,900 --> 00:55:04,734
ہاں، پرانی جاپانی مٹھائی کی دکان ہے۔

872
00:55:04,734 --> 00:55:12,686
صفت + N = [صفت] N
پرانا = پرانا ↔ نیا = نیا
جاپانی مٹھائی = جاپانی مٹھائی

873
00:55:12,709 --> 00:55:16,209
سننے کا امتحان

874
00:55:16,209 --> 00:55:20,309
ڈango لذیذ ہے؟

875
00:55:20,309 --> 00:55:25,942
کیا یہ صفت ہے؟ = کیا یہ [صفت] ہے؟
لذیذ = لذیذ ↔ بدذائقہ = بدذائقہ

876
00:55:25,965 --> 00:55:30,145
سننے کا امتحان

877
00:55:30,145 --> 00:55:35,101
ہاں، بہت لذیذ ہے۔

878
00:55:35,101 --> 00:55:41,890
بہت + صفت = بہت [صفت]
بہت = بہت

879
00:55:41,913 --> 00:55:45,180
سننے کا امتحان

880
00:55:45,180 --> 00:55:49,013
چائے بھی مل سکتی ہے؟

881
00:55:49,013 --> 00:55:54,247
کیا آپ V کر سکتے ہیں؟ = کیا آپ V کر سکتے ہیں؟
چائے = سبز چائے
پینا = پینا

882
00:55:54,270 --> 00:55:58,336
سننے کا امتحان

883
00:55:58,336 --> 00:56:03,170
ہاں، گرم چائے دستیاب ہے۔

884
00:56:03,170 --> 00:56:09,745
صفت + N = [صفت] N
گرم = گرم ↔ ٹھنڈا = ٹھنڈا

885
00:56:09,768 --> 00:56:12,606
سننے کا امتحان

886
00:56:12,606 --> 00:56:15,877
اندر چلتے ہیں۔

887
00:56:15,877 --> 00:56:20,393
N میں داخل ہوں = آئیے N میں داخل ہوں
داخل ہونا = داخل ہونا ↔ نکلنا = نکلنا

888
00:56:20,417 --> 00:56:23,550
سننے کا امتحان

889
00:56:23,550 --> 00:56:27,188
آپ کیا لیں گے؟

890
00:56:27,188 --> 00:56:32,222
آپ کون سا لیں گے؟ = آپ کون سا چنیں گے؟
کون سا = کون سا

891
00:56:32,245 --> 00:56:36,478
سننے کا امتحان

892
00:56:36,478 --> 00:56:41,511
میں انکو (میٹھی لوبیا کی پیسٹ) والا ڈango لوں گی۔

893
00:56:41,511 --> 00:56:48,378
N1 کا N2 = N1 کا N2
انکو = میٹھی لال لوبیا کی پیسٹ

894
00:56:48,401 --> 00:56:51,979
سننے کا امتحان

895
00:56:51,979 --> 00:56:56,173
میں سویا ساس والا ڈango لوں گی۔

896
00:56:56,173 --> 00:57:01,944
N پر کریں = N کا انتخاب کریں / N پر فیصلہ کریں
سویا ساس = سویا ساس

897
00:57:01,967 --> 00:57:04,401
سننے کا امتحان

898
00:57:04,401 --> 00:57:07,180
بہت اچھا ہے۔

899
00:57:07,180 --> 00:57:11,055
صفت + ہے نا؟ = اچھا ہے نا؟
اچھا = اچھا ↔ برا = برا

900
00:57:11,079 --> 00:57:14,055
سننے کا امتحان

901
00:57:14,055 --> 00:57:17,521
چائے بھی دیجیے گا۔

902
00:57:17,521 --> 00:57:22,288
برائے مہربانی N دیں = برائے مہربانی مجھے N دیں
برائے مہربانی = برائے مہربانی

903
00:57:22,311 --> 00:57:24,879
سننے کا امتحان

904
00:57:24,879 --> 00:57:27,829
شروع کرتے ہیں۔

905
00:57:27,829 --> 00:57:31,929
شروع کرتے ہیں = کھانے سے پہلے شکریہ (کھانے سے پہلے کہا جاتا ہے)

906
00:57:31,952 --> 00:57:35,462
سننے کا امتحان

907
00:57:35,462 --> 00:57:39,595
ڈango بالکل نرم ہیں۔

908
00:57:39,595 --> 00:57:45,262
N صفت ہے = N [صفت] ہے
نرم = نرم ↔ سخت = سخت

909
00:57:45,285 --> 00:57:49,453
سننے کا امتحان

910
00:57:49,453 --> 00:57:54,396
انکا میٹھا بھی لذیذ ہے۔

911
00:57:54,396 --> 00:58:01,163
صفت + اور... = [صفت] اور...
میٹھا = میٹھا ↔ مسالہ دار = مسالہ دار / نمکین

912
00:58:01,186 --> 00:58:05,519
سننے کا امتحان

913
00:58:05,519 --> 00:58:10,674
چائے کے ساتھ بہت اچھے لگتے ہیں۔

914
00:58:10,674 --> 00:58:17,741
N کے ساتھ مطابقت رکھتا ہے = N کے ساتھ مطابقت رکھتا ہے / N کے ساتھ اچھا لگتا ہے
مطابقت رکھنا = مطابقت رکھنا / موزوں ہونا

915
00:58:17,764 --> 00:58:20,340
سننے کا امتحان

916
00:58:20,340 --> 00:58:23,288
دل کو سکون ملتا ہے۔

917
00:58:23,288 --> 00:58:27,388
راحت محسوس کرنا = راحت محسوس کرنا / سکون ملنا

918
00:58:27,411 --> 00:58:31,144
سننے کا امتحان

919
00:58:31,144 --> 00:58:35,532
موسُکے ڈango بہت مقبول ہیں۔

920
00:58:35,532 --> 00:58:41,565
مشہور ہے = مشہور ہے
مشہوری = مشہوری

921
00:58:41,588 --> 00:58:45,455
سننے کا امتحان

922
00:58:45,455 --> 00:58:49,988
بہت سارے گاہک آئے ہوئے ہیں۔

923
00:58:49,988 --> 00:58:56,222
بہت سے ہیں = بہت سے ہیں (لوگ / جانور)
گاہک = گاہک / مہمان
بہت زیادہ = بہت زیادہ ↔ تھوڑا = تھوڑا

924
00:58:56,245 --> 00:58:58,878
سننے کا امتحان

925
00:58:58,878 --> 00:59:01,878
بالکل ٹھیک۔

926
00:59:01,878 --> 00:59:06,045
حقیقت میں = حقیقت میں / سچ

927
00:59:06,068 --> 00:59:09,264
سننے کا امتحان

928
00:59:09,264 --> 00:59:12,999
آرام سے بیٹھے۔

929
00:59:12,999 --> 00:59:18,141
V سکا = V کر سکا
آہستہ = آہستہ / دھیان سے

930
00:59:18,165 --> 00:59:21,431
سننے کا امتحان

931
00:59:21,431 --> 00:59:25,265
تحفے بھی خرید سکتے ہیں۔

932
00:59:25,265 --> 00:59:30,502
V سکتا ہوں = V کر سکتا ہوں / خرید سکتا ہوں
سوغات = سوغات
خریدنا = خریدنا ↔ بیچنا = بیچنا

933
00:59:30,525 --> 00:59:33,683
سننے کا امتحان

934
00:59:33,683 --> 00:59:37,383
بعد میں خرید لیں گے۔

935
00:59:37,383 --> 00:59:42,483
بعد میں V کریں = بعد میں V کریں
بعد میں = بعد میں

936
00:59:42,506 --> 00:59:46,573
سننے کا امتحان

937
00:59:46,573 --> 00:59:51,371
جاپانی مٹھائیاں واقعی شاندار ہوتی ہیں۔

938
00:59:51,371 --> 00:59:57,928
N1 + کے + N2 = N1 کا N2
شاندار = wonderful

939
00:59:57,952 --> 01:00:01,862
سننے کا امتحان

940
01:00:01,862 --> 01:00:06,495
ہاں، مجھے بھی بہت پسند ہیں۔

941
01:00:06,495 --> 01:00:12,836
N + بہت پسند ہے = N سے بہت محبت ہے / N بہت پسند ہے
بہت پسند (محبت) ↔ بہت ناپسند (نفرت)

942
01:00:12,860 --> 01:00:17,014
سننے کا امتحان

943
01:00:17,014 --> 01:00:21,952
چلو، اب آگے چلتے ہیں۔

944
01:00:21,952 --> 01:00:28,694
V کریں گے؟ = کیا ہم V کریں؟
چلو = اب / آئیے
اگلا = اگلا

945
01:00:28,717 --> 01:00:32,217
سننے کا امتحان

946
01:00:32,217 --> 01:00:36,333
جی ہاں۔ چلیں۔

947
01:00:36,333 --> 01:00:42,000
V کرتے ہیں = آئیے V کریں
جانا (جاؤ) ↔ آنا (آؤ)

948
01:00:42,023 --> 01:00:43,523
منظر 8: مچھلی فرائی کی دکان / سی فوڈ فرائی ریستوراں

949
01:00:43,523 --> 01:00:47,590
سننے کا امتحان

950
01:00:47,590 --> 01:00:52,423
کیا ابھی کھا سکتے ہیں؟

951
01:00:52,423 --> 01:00:59,002
ابھی تک V سکتے ہو؟ = کیا تم ابھی تک V کر سکتے ہو؟
ابھی تک = ابھی / اب تک

952
01:00:59,026 --> 01:01:02,211
سننے کا امتحان

953
01:01:02,211 --> 01:01:05,922
ہاں، بالکل ٹھیک ہوں۔

954
01:01:05,922 --> 01:01:11,035
ٹھیک ہے = ٹھیک ہے / ٹھیک ٹھاک

955
01:01:11,059 --> 01:01:14,025
سننے کا امتحان

956
01:01:14,025 --> 01:01:17,463
اودا یاسو چلیں۔

957
01:01:17,463 --> 01:01:22,197
V کرتے ہیں = آئیے V کریں
جانا (جاؤ) ↔ آنا (آؤ)

958
01:01:22,220 --> 01:01:26,296
سننے کا امتحان

959
01:01:26,296 --> 01:01:31,129
اودا یاسو کس طرح کی دکان ہے؟

960
01:01:31,129 --> 01:01:37,762
کس قسم کا N؟ = کس قسم کا N؟
دکان = دکان / اسٹور

961
01:01:37,785 --> 01:01:41,218
سننے کا امتحان

962
01:01:41,218 --> 01:01:45,252
فرائی کی دکان ہے۔

963
01:01:45,252 --> 01:01:50,786
N1 کا N2 = N1 کا N2
فرائی = تلی ہوئی چیز

964
01:01:50,809 --> 01:01:53,876
سننے کا امتحان

965
01:01:53,876 --> 01:01:57,430
مچھلی کی فرائی؟

966
01:01:57,430 --> 01:02:02,334
کیا یہ N ہے؟ = کیا یہ N ہے؟
مچھلی = مچھلی

967
01:02:02,358 --> 01:02:07,058
سننے کا امتحان

968
01:02:07,058 --> 01:02:12,653
ہاں، اجی فرائی بہت مشہور ہے۔

969
01:02:12,653 --> 01:02:20,319
N مشہور ہے = N بہت مشہور ہے
مشہور = مشہور

970
01:02:20,342 --> 01:02:23,736
سننے کا امتحان

971
01:02:23,736 --> 01:02:27,717
یہ تو بہت لذیذ لگ رہا ہے۔

972
01:02:27,717 --> 01:02:33,185
اچھا لگ رہا ہے = لگتا ہے...
مزیدار (لذیذ) ≒ بہت مزیدار (لذیذ)

973
01:02:33,209 --> 01:02:36,875
سننے کا امتحان

974
01:02:36,875 --> 01:02:41,175
دکان وہاں ہے۔

975
01:02:41,175 --> 01:02:47,053
N وہاں ہے = N وہاں ہے
وہاں = وہاں

976
01:02:47,077 --> 01:02:49,910
سننے کا امتحان

977
01:02:49,910 --> 01:02:53,177
مینو دیکھتے ہیں۔

978
01:02:53,177 --> 01:02:57,710
V کرتے ہیں = آئیے V کریں
دیکھنا = دیکھنا / مشاہدہ کرنا

979
01:02:57,733 --> 01:03:01,167
سننے کا امتحان

980
01:03:01,167 --> 01:03:05,200
کاسٹڈ اویسٹرز بھی ہیں۔

981
01:03:05,200 --> 01:03:10,700
N بھی ہے = N بھی موجود ہے
کاکی فرائی = تلی ہوئی سیپ

982
01:03:10,723 --> 01:03:15,061
سننے کا امتحان

983
01:03:15,061 --> 01:03:20,216
میں اجی فرائی لوں گا۔

984
01:03:20,216 --> 01:03:27,283
N کا انتخاب کریں = N کا فیصلہ کریں
آجی فرائی = تلی ہوئی میکرل

985
01:03:27,306 --> 01:03:30,872
سننے کا امتحان

986
01:03:30,872 --> 01:03:35,050
میں کاسٹڈ اویسٹرز لوں گا۔

987
01:03:35,050 --> 01:03:40,798
N کا انتخاب کریں = N کا فیصلہ کریں

988
01:03:40,822 --> 01:03:44,122
سننے کا امتحان

989
01:03:44,122 --> 01:03:47,989
ذرا سا بانٹ لیں گے؟

990
