00:29:11,803 --> 00:29:16,236
ابھی تو سشی کھائی ہے۔

509
00:29:16,236 --> 00:29:22,303
فعل + یا = کیا (مہذب ماضی)
تھوڑی دیر پہلے = تھوڑی دیر پہلے

510
00:29:22,326 --> 00:29:25,514
سننے کا امتحان

511
00:29:25,514 --> 00:29:29,227
مگر مجھے کھانی ہے۔

512
00:29:29,227 --> 00:29:34,337
لیکن = لیکن / تاہم

513
00:29:34,361 --> 00:29:36,794
سننے کا امتحان

514
00:29:36,794 --> 00:29:39,571
ٹھیک ہے۔

515
00:29:43,461 --> 00:29:47,219
سننے کا امتحان

516
00:29:47,219 --> 00:29:51,652
اودایڈو نامی دکان پر چلیں۔

517
00:29:51,652 --> 00:29:57,719
N1 + کہلانے والا + N2 = N2 جسے N1 کہتے ہیں
دکان = دکان / ریستوران

518
00:29:57,742 --> 00:30:00,720
سننے کا امتحان

519
00:30:00,720 --> 00:30:04,186
کیا وہ بھی مشہور ہے؟

520
00:30:04,186 --> 00:30:08,969
N + بھی = بھی / بھی
مشہور (مشہور) ↔ گمنام (گمنام)

521
00:30:08,993 --> 00:30:13,627
سننے کا امتحان

522
00:30:13,627 --> 00:30:19,129
جی ہاں، سمندری ڈونبوری کی مشہور دکان ہے۔

523
00:30:19,129 --> 00:30:26,629
N1 + کا + N2 = N1 کا N2 (اسم کی تبدیلی)
مشہور دکان = مشہور دکان/ریستوران

524
00:30:26,652 --> 00:30:28,928
سننے کا امتحان

525
00:30:28,928 --> 00:30:31,498
یہی ہے نا؟

526
00:30:35,109 --> 00:30:38,489
سننے کا امتحان

527
00:30:38,489 --> 00:30:42,441
مینو میں بہت ساری چیزیں ہیں۔

528
00:30:42,441 --> 00:30:47,907
N + ہے = N موجود ہے
مینو = مینو

529
00:30:47,930 --> 00:30:50,564
سننے کا امتحان

530
00:30:50,564 --> 00:30:53,597
آپ کیا لیں گے؟

531
00:30:53,597 --> 00:30:57,773
N + کا انتخاب کریں = N کا انتخاب کریں
کون سا = کون سا (تین یا زیادہ میں سے)

532
00:30:57,797 --> 00:31:01,389
سننے کا امتحان

533
00:31:01,389 --> 00:31:05,622
میں اِکُرا ڈونبوری لوں گا۔

534
00:31:05,622 --> 00:31:11,455
N + کا انتخاب کریں = N کا انتخاب کریں
سالمن رو = سالمن رو

535
00:31:11,478 --> 00:31:15,545
سننے کا امتحان

536
00:31:15,545 --> 00:31:20,336
میں یونی اور اِکُرا لوں گا۔

537
00:31:20,336 --> 00:31:26,870
N1 + اور + N2 = N1 اور N2
اونی = سمندری کچوا

538
00:31:26,894 --> 00:31:29,727
سننے کا امتحان

539
00:31:29,727 --> 00:31:32,964
بہت شاندار ہے۔

540
00:31:32,964 --> 00:31:37,436
نا صفت + ہے نا؟ = یہ ... ہے نا؟
شاندار (شاندار) ↔ سادہ (سادہ)

541
00:31:37,459 --> 00:31:40,893
سننے کا امتحان

542
00:31:40,893 --> 00:31:44,926
جی ہاں، بہت دلچسپ ہے۔

543
00:31:44,926 --> 00:31:50,459
انتظار = انتظار کرنا / مزہ

544
00:31:50,482 --> 00:31:53,516
سننے کا امتحان

545
00:31:53,516 --> 00:31:57,049
واہ، آ گئی ہے۔

546
00:32:01,912 --> 00:32:05,910
سننے کا امتحان

547
00:32:05,910 --> 00:32:10,643
واہ، ڈونبوری چمک رہی ہے۔

548
00:32:10,643 --> 00:32:17,143
فعل + رہا ہے = کر رہا ہے (حالت حال / حالت)
ڈونبوری = پیالہ (کھانے کا پیالہ)

549
00:32:17,166 --> 00:32:20,242
سننے کا امتحان

550
00:32:20,242 --> 00:32:23,841
کیا سوئیابین ڈالیں؟

551
00:32:23,841 --> 00:32:28,786
N + کو + فعل = مفعول کی علامت کو
سویا ساس = سویا ساس

552
00:32:28,809 --> 00:32:32,443
سننے کا امتحان

553
00:32:32,443 --> 00:32:36,714
جی ہاں، تھوڑی سی ڈالوں گا۔

554
00:32:36,714 --> 00:32:42,580
تعداد + صرف = صرف / بس
تھوڑا (تھوڑا) ↔ بہت (بہت)

555
00:32:42,603 --> 00:32:44,959
سننے کا امتحان

556
00:32:44,959 --> 00:32:47,659
شروع کرتے ہیں۔

557
00:32:47,659 --> 00:32:51,406
اِتاداکی ماس = کھانے سے پہلے کا جملہ

558
00:32:51,430 --> 00:32:54,799
سننے کا امتحان

559
00:32:54,799 --> 00:32:58,740
یہ بھی لاجواب ہے۔

560
00:32:58,740 --> 00:33:04,176
N + بھی = بھی / بھی
بہترین (بہترین) ↔ بدترین (بدترین)

561
00:33:04,200 --> 00:33:07,833
سننے کا امتحان

562
00:33:07,833 --> 00:33:12,100
یونی میٹھی اور ملتی ہوئی ہے۔

563
00:33:12,100 --> 00:33:17,967
اِی صفت + کر = ہے ... اور ... (اِی صفت کا جوڑنے والا روپ)
میٹھا (میٹھا) ↔ مسالہ دار (تیز)
پگھلنا = منہ میں پگھلنا

564
00:33:17,990 --> 00:33:21,492
سننے کا امتحان

565
00:33:21,492 --> 00:33:25,600
اِکُرا میں لچک ہے۔

566
00:33:25,600 --> 00:33:31,233
N + ہے = N رکھنا / پاس ہونا
لچک = لچک / اچھال

567
00:33:31,256 --> 00:33:34,446
سننے کا امتحان

568
00:33:34,446 --> 00:33:38,179
بہت لذیذ ہے۔

569
00:33:38,179 --> 00:33:43,295
واقعی = واقعی / سچ میں

570
00:33:43,318 --> 00:33:46,418
سننے کا امتحان

571
00:33:46,418 --> 00:33:50,011
چاول نظر ہی نہیں آ رہے۔

572
00:33:50,011 --> 00:33:54,978
فعل + نہیں سکتا = نہیں کر سکتا (منفی صلاحیت)
چاول = پکا ہوا چاول / کھانا

573
00:33:55,001 --> 00:33:59,034
سننے کا امتحان

574
00:33:59,034 --> 00:34:03,791
مچھلی بہت زیادہ ہے۔

575
00:34:03,791 --> 00:34:10,300
فعل + رہا ہے = ہے / ہیں (نتیجہ کی حالت)
سوار ہونا (اوپر ہونا) ↔ اترنا (اترنا)

576
00:34:10,324 --> 00:34:13,258
سننے کا امتحان

577
00:34:13,258 --> 00:34:16,645
یہ عیش و آرام کا وقت ہے۔

578
00:34:16,645 --> 00:34:21,345
نا صفت + کا + N = نا صفت کا اسم کی تبدیلی والا روپ
فضول خرچی = عیش و عشرت / شاندار

579
00:34:21,368 --> 00:34:24,434
سننے کا امتحان

580
00:34:24,434 --> 00:34:27,990
اودایڈو بہت مزیدار ہے۔

581
00:34:27,990 --> 00:34:32,892
اِی صفت + ہے نا؟ = یہ ... ہے نا؟
مزیدار (مزیدار) ↔ بدذائقہ (بدذائقہ)

582
00:34:32,915 --> 00:34:37,049
سننے کا امتحان

583
00:34:37,049 --> 00:34:41,949
جی ہاں، ضرور پھر آئیں گے۔

584
00:34:41,949 --> 00:34:48,649
فعل +یں = آؤ کریں
یقینا = یقینا / بالکل

585
00:34:48,672 --> 00:34:50,172
سیین 4: ٹونا نیلامی کا دورہ / ٹونا کی نیلامی دیکھنے کا دورہ

586
00:34:50,172 --> 00:34:53,926
سننے کا امتحان

587
00:34:53,926 --> 00:34:58,359
ٹونا کی نیلامی دیکھنے چلیں۔

588
00:34:58,359 --> 00:35:04,426
فعل کی جڑ +نے جائیں = V کرنے کے لیے جائیں
نیلامی = نیلامی

589
00:35:04,449 --> 00:35:07,349
سننے کا امتحان

590
00:35:07,349 --> 00:35:10,715
کہاں دیکھ سکتے ہیں؟

591
00:35:10,715 --> 00:35:15,349
فعل مصدر + سکنا = V کر سکنا
کہاں = کہاں

592
00:35:15,372 --> 00:35:18,844
سننے کا امتحان

593
00:35:18,844 --> 00:35:22,944
دیکھنے کا کورس موجود ہے۔

594
00:35:22,944 --> 00:35:28,539
N + ہے = N موجود ہے
سیاحت = دورہ / مطالعہ دورہ

595
00:35:28,562 --> 00:35:31,396
سننے کا امتحان

596
00:35:31,396 --> 00:35:34,670
کیا یہاں سے دور ہے؟

597
00:35:34,670 --> 00:35:39,205
N + سے = N سے
دور (دور) ↔ قریب (قریب)

598
00:35:39,228 --> 00:35:42,695
سننے کا امتحان

599
00:35:42,695 --> 00:35:46,728
نہیں۔ قریب ہے۔

600
00:35:46,728 --> 00:35:52,262
اِی صفت + ہے = یہ ہے [صفت]
قریب (قریب) ↔ دور (دور)

601
00:35:52,285 --> 00:35:55,918
سننے کا امتحان

602
00:35:55,918 --> 00:36:00,185
ٹونا مچھلی بہت زیادہ ہے نا۔

603
00:36:00,185 --> 00:36:06,018
بہت + N = بہت سا N
بہت (بہت) ↔ تھوڑا (تھوڑا)

604
00:36:06,041 --> 00:36:10,108
سننے کا امتحان

605
00:36:10,108 --> 00:36:14,906
ہاں۔ بہت بڑی ہے۔

606
00:36:14,906 --> 00:36:21,456
بہت + اِی صفت = بہت [صفت]
بڑا (بڑا) ↔ چھوٹا (چھوٹا)

607
00:36:21,479 --> 00:36:24,855
سننے کا امتحان

608
00:36:24,855 --> 00:36:28,800
مارکیٹ کے اندر ٹھنڈ ہے؟

609
00:36:28,800 --> 00:36:34,234
N1 کا N2 = N1 کا N2
منڈی = منڈی
اندر (اندر) ↔ باہر (باہر)

610
00:36:34,257 --> 00:36:37,723
سننے کا امتحان

611
00:36:37,723 --> 00:36:41,760
تھوڑی سی ٹھنڈ ہے۔

612
00:36:41,760 --> 00:36:47,331
تھوڑا + اِی صفت = تھوڑا [صفت]
ٹھنڈا (ٹھنڈا) ↔ گرم (گرم)

613
00:36:47,355 --> 00:36:50,255
سننے کا امتحان

614
00:36:50,255 --> 00:36:53,591
میں نے جیکٹ لائی ہے۔

615
00:36:53,591 --> 00:36:58,224
فعل + کر آنا = ساتھ لانا / لے کر آنا
اوپر کا کپڑا = جیکٹ / کوٹ

616
00:36:58,247 --> 00:37:01,581
سننے کا امتحان

617
00:37:01,581 --> 00:37:05,481
وہ اچھا ہوا۔

618
00:37:05,481 --> 00:37:10,822
[جملہ] + اچھا ہوا = مجھے خوشی ہے کہ...

619
00:37:10,845 --> 00:37:14,623
سننے کا امتحان

620
00:37:14,623 --> 00:37:19,090
وہ لوگ کیا کر رہے ہیں؟

621
00:37:19,090 --> 00:37:25,206
فعل + رہا ہے = V کر رہا ہے (حالت حال)
وہ لوگ = وہ لوگ

622
00:37:25,229 --> 00:37:29,529
سننے کا امتحان

623
00:37:29,529 --> 00:37:34,634
ٹونا مچھلی کی قیمت طے کر رہے ہیں۔

624
00:37:34,634 --> 00:37:41,589
Vて + いる = کوئی کام کر رہا ہوں (تسلسل میں)
قیمت = قیمت
طے کرنا = فیصلہ کرنا

625
00:37:41,613 --> 00:37:45,395
سننے کا امتحان

626
00:37:45,395 --> 00:37:49,861
آواز اچھی طرح سنائی نہیں دے رہی۔

627
00:37:49,861 --> 00:37:55,978
Vpotential-منفی (سنا نہیں جا رہا) = سن نہیں سکتا
آواز = آواز

628
00:37:56,002 --> 00:37:58,672
سننے کا امتحان

629
00:37:58,672 --> 00:38:01,750
شیشہ ہونے کی وجہ سے۔

630
00:38:01,750 --> 00:38:06,050
[جملہ] + سے = کیونکہ...
شیشہ = گلاس

631
00:38:06,073 --> 00:38:09,906
سننے کا امتحان

632
00:38:09,906 --> 00:38:14,412
مگر بہت دلچسپ ہے۔

633
00:38:14,412 --> 00:38:20,598
مگر + [جملہ] = لیکن...
دلچسپ (دلچسپ) ↔ بور (بورنگ)

634
00:38:20,621 --> 00:38:24,159
سننے کا امتحان

635
00:38:24,159 --> 00:38:28,307
دیکھ کر اچھا لگا۔

636
00:38:28,307 --> 00:38:34,007
Vて + اچھا ہوا = مجھے خوشی ہے کہ میں نے V کیا

637
00:38:34,030 --> 00:38:37,497
سننے کا امتحان

638
00:38:37,497 --> 00:38:41,563
عموماً کتنے بجے سے شروع ہوتا ہے؟

639
00:38:41,563 --> 00:38:47,117
کتنے بجے + کے قریب = تقریباً کتنے بجے ہیں
ہمیشہ = ہمیشہ / عام طور پر

640
00:38:47,141 --> 00:38:50,641
سننے کا امتحان

641
00:38:50,641 --> 00:38:54,751
صبح پانچ بجے سے۔

642
00:38:54,751 --> 00:39:00,417
[وقت] + سے = سے [وقت]
صبح (صبح) ↔ شام (شام)

643
00:39:00,440 --> 00:39:03,474
سننے کا امتحان

644
00:39:03,474 --> 00:39:07,007
بہت جلدی ہے نا۔

645
00:39:07,007 --> 00:39:11,874
بہت + ایڈجیکٹو = بہت [صفت]
جلد (جلد) ↔ دیر (دیر سے)

646
00:39:11,897 --> 00:39:16,563
سننے کا امتحان

647
00:39:16,563 --> 00:39:22,130
ہاں۔ ہم تھوڑے دیر سے آئے ہیں۔

648
00:39:22,130 --> 00:39:29,707
ہم / ہمیں = ہم
دیر (دیر سے) ↔ جلد (جلد)

649
00:39:29,731 --> 00:39:33,281
سننے کا امتحان

650
00:39:33,281 --> 00:39:37,451
تھوڑا سا ہی دیکھ پائے۔

651
00:39:37,451 --> 00:39:43,184
[مقدار] + صرف + Vمنفی = صرف
تھوڑا = تھوڑا

652
00:39:43,207 --> 00:39:47,685
سننے کا امتحان

653
00:39:47,685 --> 00:39:53,026
ہاں۔ اگلی بار پھر دیکھیں گے۔

654
00:39:53,026 --> 00:40:00,326
پھر + [جملہ] = دوبارہ / اگلی بار
اگلا = اگلا

655
00:40:00,349 --> 00:40:03,723
سننے کا امتحان

656
00:40:03,723 --> 00:40:07,683
جلدی اٹھنا پڑے گا نا۔

657
00:40:07,683 --> 00:40:13,150
Vمنفی (جلد نہیں اٹھتا) ➔ کرنا ضروری ہے = V کرنا ضروری ہے
جلد اٹھنا = جلد اٹھنا

658
00:40:13,173 --> 00:40:15,606
سننے کا امتحان

659
00:40:15,606 --> 00:40:18,339
ہاں۔

660
00:40:22,197 --> 00:40:26,230
سننے کا امتحان

661
00:40:26,230 --> 00:40:30,997
مگر مارکیٹ کا ماحول سمجھ آ گیا۔

662
00:40:30,997 --> 00:40:37,510
مگر + [جملہ] = لیکن...
ماحول = ماحول

663
00:40:37,534 --> 00:40:41,567
سننے کا امتحان

664
00:40:41,567 --> 00:40:46,347
یہاں تصویر لے لیتے ہیں؟

665
00:40:46,347 --> 00:40:52,881
Vstem + چلیں؟ = کیا ہم V کریں؟
تصویر کھینچنا = تصویر کھینچنا

666
00:40:52,905 --> 00:40:55,379
سننے کا امتحان

667
00:40:55,379 --> 00:40:58,212
ہاں۔ براہ کرم۔

668
00:40:58,212 --> 00:41:02,126
برائے مہربانی = برائے مہربانی

669
00:41:02,150 --> 00:41:05,096
سننے کا امتحان

670
00:41:05,096 --> 00:41:08,529
بہت اچھی تصویر آئی ہے۔

671
